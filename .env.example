# ---------------------------------------------------------------------
#  J.A.R.V.I.S - reglages
# ---------------------------------------------------------------------
#  Copiez ce fichier en « .env » et remplissez ce dont vous avez besoin.
#  Celui-ci est un MODELE : il ne contient aucune valeur.
#
#  Liste exactement les variables de config.REGLAGES, que l'installeur
#  propose : _test_config.py echoue si l'un des deux diverge de l'autre.
# ---------------------------------------------------------------------

# == Indispensable ====================================================

# Le modèle principal. Sans lui, JARVIS ne répond qu'avec ses outils locaux.
#   -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Protège le WebSocket, qui exécute les commandes système.
#   -> à inventer : une longue chaîne aléatoire
JARVIS_ACCESS_TOKEN=

# == Facultatif =======================================================
#  JARVIS demarre sans. Chaque ligne debloque une fonction.

# Domotique Home Assistant.
#   -> Profil → Jetons d'accès de longue durée, dans Home Assistant
HA_URL=
HA_TOKEN=

# Modèle de secours, rapide.
#   -> https://console.groq.com/keys
GROQ_API_KEY=

# Modèles OpenAI.
#   -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modèles Claude.
#   -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modèles Mistral.
#   -> https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Modeles Grok (xAI).
#   -> https://console.x.ai
XAI_API_KEY=

# Fournisseur supplementaire compatible OpenAI (routeur local par exemple) :
# adresse /v1, cle et modele.
EXTRA_LLM_1_URL=
EXTRA_LLM_1_KEY=
EXTRA_LLM_1_MODEL=

# Recherche web.
#   -> https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Recherche YouTube.
#   -> https://console.cloud.google.com/apis
YOUTUBE_API_KEY=

# Conversion de devises. Vide = api.frankfurter.app, sans cle.
#   -> https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=

# Notification push (taches nocturnes terminees/echouees).
#   -> Discord -> Parametres du salon -> Integrations -> Webhooks -> Nouveau webhook
DISCORD_WEBHOOK_URL=

# Bot Discord : discuter avec JARVIS et lui donner des commandes a distance.
#   -> https://discord.com/developers/applications -> New Application -> Bot
#      -> activer "Message Content Intent" -> copier le token
#   DISCORD_USER_ID = votre ID Discord (mode developpeur active dans Discord ->
#      clic droit sur votre pseudo -> Copier l'ID). Seul cet ID peut donner des
#      commandes au bot ; tout le monde d'autre dans le salon est ignore.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Notification push, meme usage que DISCORD_WEBHOOK_URL mais sur Slack.
#   -> Slack -> creer une app -> Incoming Webhooks -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# Heures calmes pour les notifications push (tache non critique reportee
# au prochain briefing au lieu de pousser en pleine nuit). Vide = defaut
# 22:00-08:00. Voir notifications.en_heures_calmes().
JARVIS_HEURES_CALMES_DEBUT=
JARVIS_HEURES_CALMES_FIN=

# == Options desactivees par defaut ===================================
#  Chaque bloc ne sert que si la capacite correspondante est cochee dans
#  l'assistant d'installation.

# Emploi du temps et revisions Pronote (via l'integration hass-pronote de
# Home Assistant) : debut du nom des capteurs, sans « sensor. ».
#   ex. sensor.pronote_dupont_alex_homework -> pronote_dupont_alex
PRONOTE_SENSOR_PREFIX=
# Revisions : classe de l'eleve (ex. 4e), et modeles Ollama (vide = defaut).
JARVIS_NIVEAU_SCOLAIRE=
JARVIS_REVISIONS_MODELE=
JARVIS_REVISIONS_JUGE=

# Notes Notion.
#   -> https://www.notion.so/my-integrations ; page partagee avec l'integration
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Domotique : entites propres a votre maison. Vide = commande refusee
# poliment plutot qu'envoyee a une entite qui n'existe pas.
#   ex. alarm_control_panel.maison, lock.porte_entree, vacuum.robot,
#       sensor.compteur_linky (prefixe des capteurs _p1_daily, _p1_mensuel...)
HA_ALARME_ENTITY=
HA_VERROU_ENTITY=
HA_ASPIRATEUR_ENTITY=
HA_LINKY_PREFIX=
# Entite meteo de Home Assistant. Vide = weather.home
HA_WEATHER_ENTITY=

# Carte OSINT 3D (God's Eye View + ShadowBroker), installes a part.
GODSEYE_DIR=
GODSEYE_URL=
SHADOWBROKER_DIR=
SHADOWBROKER_API_URL=
SHADOWBROKER_HMAC_SECRET=
# 1 = demarrer la carte avec JARVIS. Vide/0 = jamais.
SHADOWBROKER_AUTOSTART=

# Acces aux fichiers : dossiers que JARVIS peut lire/ecrire, separes par
# « ; ». Vide = Bureau, Documents, Telechargements... du profil courant.
# Defini, il borne aussi les dossiers acceptes comme projets de code.
JARVIS_DOSSIERS_AUTORISES=

# Delegation de code : modele passe a OpenCode (fournisseur/modele). Vide =
# OpenCode n'est pas essaye. Proxy (hote:port) facultatif : s'il est
# renseigne, il doit repondre avant qu'OpenCode soit lance.
JARVIS_OPENCODE_MODELE=
JARVIS_OPENCODE_PROXY=

# == Mises a jour =====================================================
# Depot interroge au lancement pour savoir s'il existe une version plus
# recente. Vide = aucune verification.
JARVIS_DEPOT=

# == Avance ===========================================================
# Interface : dossier et port. Vide = frontend/ livre avec JARVIS, port 5173.
JARVIS_INTERFACE_DIR=
JARVIS_INTERFACE_PORT=
# Ollama local : adresse et modele par defaut.
JARVIS_OLLAMA_BASE_URL=
JARVIS_OLLAMA_MODEL=
# Musique lancee sur demande : playlist Spotify (spotify:playlist:...) ou
# video YouTube.
SPOTIFY_MUSIQUE_URI=
YOUTUBE_MUSIQUE_URL=
# Chemins d'applications introuvables automatiquement.
CHROME_PATH=
ANTIGRAVITY_PATH=
